{
  "_meta": {
    "bootstrap_iters": 2000,
    "definitions": {
      "exact_total_rate": "draws with usable pred == gold, over ALL draws (unusable draws are misses) -- comparable to exact match, which additionally requires peak/trough",
      "gold": "src.nodes.validator.oracle(rebuilt program)['total'], asserted > 0",
      "illustration_only": "n_clusters < 5 base IRs in the cell (every agg_stats W is a single base program; W16/W32 variants share theirs), so no CI is drawn and the cell is descriptive",
      "order_of_magnitude_rate": "usable draws with pred > 0 and |log10(pred/gold)| <= 0.5, over usable draws (non-positive preds counted in n_nonpositive_pred)",
      "pred": "extract_json_obj(raw)['total']; None/missing/non-numeric (incl. booleans, non-finite) -> n_unusable, never imputed",
      "rel_err": "|pred - gold| / gold over USABLE draws; median/quartiles use linear interpolation; winsorized mean clips floor(0.05*n) values in each tail"
    },
    "family": "agg_stats",
    "generated_by": "bench/partial_credit_analysis.py",
    "inputs": [
      "bench/out/ladder/comprehend__*.jsonl.gz",
      "bench/out/ladder_scaling.json"
    ],
    "kill_switches": [
      "KILL 1: exact_total_rate >= recomputed EM (exact) and >= published EM - 5e-4 (rounding ulp) per cell",
      "KILL 2: round(recomputed EM, 3) == published ladder_scaling.json agg_stats value per (model, W)"
    ],
    "suite_seed": 20260814,
    "zero_api": true
  },
